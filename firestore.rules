// ŞantiyePro Firestore güvenlik kuralları
//
// Bu dosya Firebase konsolunda YAYINDA OLAN kuralların birebir kopyasıdır
// (3 Ocak 2026'da yayınlanan sürüm). Konsolla depo arasında fark oluşmasın
// diye burada tutuluyor; değiştirirseniz konsolda da güncelleyin.
//
// Veri düzeni:
//   users/{uid}                     -> profil (ad, e-posta, doğum tarihi)
//   users/{uid}/data/{koleksiyon}   -> uygulama verisi (tek alanda JSON metni)
//
// Kural: kullanıcı YALNIZCA kendi profiline ve kendi data/ klasörüne erişir.
// users/{uid} altındaki başka alt koleksiyonlara bilerek izin verilmez;
// uygulama yalnızca data/ kullanıyor.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
